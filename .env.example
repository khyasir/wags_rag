# Copy to .env and fill in. .env is gitignored.

ODOO_URL=http://localhost:8069
ODOO_DB=
ODOO_USER=
# API key. Falls back to ODOO_PASSWORD when running locally.
ODOO_KEY=
ODOO_PASSWORD=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TZ_NAME=Asia/Riyadh

# Earliest date that may be queried.
#   set to a date -> ranges before it are refused, overlapping ranges are
#                    clipped and the answer says so.
#   left BLANK    -> no floor at all, full history is queried.
# Production ships 2026-01-01. Local testing leaves it blank.
DATA_START=2026-01-01

# Empty means all branches. Comma list narrows scope, e.g. 1,5
BRANCH_IDS=

DAILY_QUERY_LIMIT=10
MAX_BUCKETS=200
RPC_TIMEOUT=30
